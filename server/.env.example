# ==============================================================================
# PolishedByAnshika — Production Environment Variables Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file as `.env` in the server root: `cp .env.example .env`
# 2. Never commit the `.env` file to Git or version control!
# 3. Replace all placeholder values below with your real production credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Set to 'production' for live deployment, 'development' for local coding
NODE_ENV=production

# The port where Express will listen (Default: 5001 or 5000)
# (On PaaS like AWS/Heroku/Render, PORT is automatically injected by host)
PORT=5001

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB Atlas)
# ------------------------------------------------------------------------------
# How to get:
# 1. Log into https://cloud.mongodb.com
# 2. Go to Database > Click "Connect" on your cluster > Drivers (Node.js)
# 3. Replace <username> and <password> with your Database User credentials
# Note: If your password contains special characters (@, :, /, %), URL-encode them.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/polishedbyanshika?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SECURITY
# ------------------------------------------------------------------------------
# High-entropy secret key used to sign and verify JSON Web Tokens.
# Generate a secure 64-character hex key via terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_generated_64_character_crypto_hex_key_here

# Token lifetime (e.g., '30d', '7d', '24h')
JWT_EXPIRE=30d

# ------------------------------------------------------------------------------
# 4. MEDIA & IMAGE STORAGE (Cloudinary)
# ------------------------------------------------------------------------------
# Used for storing product photos, review images, custom nail art requests, and banners.
# How to get:
# 1. Log into https://console.cloudinary.com
# 2. Go to Dashboard > API Keys / Environment Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAILS (Resend)
# ------------------------------------------------------------------------------
# How to get:
# 1. Log into https://resend.com > API Keys > Create API Key
# 2. Go to Domains > Add your custom domain and add DNS records (DKIM, SPF)
# 3. Use an email address verified on your domain for FROM_EMAIL
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=orders@yourdomain.com

# ------------------------------------------------------------------------------
# 6. CORS & CLIENT ACCESS (Allowed Origins)
# ------------------------------------------------------------------------------
# Crucial for CORS security! Comma-separated list of allowed frontend URLs.
# In production: Include your root domain and www subdomain (NO trailing slashes).
# Example: https://polishedbyanshika.com,https://www.polishedbyanshika.com
CLIENT_URL=https://yourdomain.com,https://www.yourdomain.com

# ------------------------------------------------------------------------------
# 7. BUSINESS DETAILS & E-COMMERCE DEFAULTS
# ------------------------------------------------------------------------------
# Displayed in public policy pages, invoices, WhatsApp chat triggers, and checkout:
BUSINESS_NAME=PolishedByAnshika
BUSINESS_WHATSAPP=+91XXXXXXXXXX
BUSINESS_INSTAGRAM=@polishedbyanshika
BUSINESS_EMAIL=contact@yourdomain.com
BUSINESS_UPI=yourname@upi

# Shipping defaults (INR ₹)
FREE_SHIPPING_ABOVE=499
SHIPPING_CHARGE=50
