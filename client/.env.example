# ==============================================================================
# PolishedByAnshika — Client Frontend Environment Variables
# ==============================================================================
# In production with Nginx reverse proxy on the same domain:
# VITE_API_URL=/api
#
# If frontend and backend are hosted on separate domains/subdomains:
# VITE_API_URL=https://api.yourdomain.com/api
#
# Local development:
VITE_API_URL=http://localhost:5001/api
